<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- 1️⃣ IISNode Configuration -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- 2️⃣ PassThrough Errors to let Next.js handle 404s -->
    <httpErrors existingResponse="PassThrough" />

    <rewrite>
      <rules>
        <!-- 3️⃣ Force non-www → www -->
        <rule name="Force WWW" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^mindsmiratus\.com$" />
          </conditions>
          <action type="Redirect" url="https://www.mindsmiratus.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 4️⃣ Serve Static Assets from public folder -->
        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}" />
        </rule>

        <!-- 5️⃣ Next.js Handler (Everything else goes to server.js) -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Optional: Increase request limits if needed -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin"/>
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- IISNode specific settings -->
    <iisnode
      node_env="production"
      loggingEnabled="true"
      devErrorsEnabled="false"
    />
    
  </system.webServer>
</configuration>


